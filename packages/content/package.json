{
  "name": "@museum/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./plan-schema": {
      "types": "./dist/plan-schema.d.ts",
      "import": "./dist/plan-schema.js"
    },
    "./zones": {
      "types": "./dist/zones.d.ts",
      "import": "./dist/zones.js"
    },
    "./generated/building.json": "./generated/building.json",
    "./generated/standpoints.json": "./generated/standpoints.json",
    "./generated/navmesh.bin": "./generated/navmesh.bin",
    "./data/exhibits.json": "./data/exhibits.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && tsx scripts/check-blueprint.ts",
    "check:blueprint": "tsx scripts/check-blueprint.ts"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
