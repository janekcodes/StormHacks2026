{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022"],
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@museum/scene": ["packages/scene/src/index.ts"],
      "@museum/scene/map": ["packages/scene/src/map.ts"],
      "@museum/content": ["packages/content/src/index.ts"],
      "@museum/content/schema": ["packages/content/src/schema.ts"],
      "@museum/content/plan-schema": ["packages/content/src/plan-schema.ts"],
      "@museum/content/zones": ["packages/content/src/zones.ts"],
      "@museum/content/generated/building.json": ["packages/content/generated/building.json"],
      "@museum/content/generated/standpoints.json": ["packages/content/generated/standpoints.json"],
      "@museum/content/data/exhibits.json": ["packages/content/data/exhibits.json"],
      "@museum/guide": ["packages/guide/src/index.ts"],
      "@museum/portal-template": ["packages/portals/_template/src/index.ts"]
    }
  }
}
