# Server-only secrets. Never import these in client code, never log or print them.

# Server only: Gemini API key for the AI guide (BLUEPRINT section 11).
GEMINI_API_KEY=

# Server and CI only: ElevenLabs API key for narration build and live guide speech (BLUEPRINT section 12).
ELEVENLABS_API_KEY=

# Server and CI: the museum voice, one voice for narrator and guide.
ELEVENLABS_VOICE_ID=

# Model IDs are read from config, never hardcoded in application code (BLUEPRINT section 10).

# Server only: Gemini model for the text guide. Current default: gemini-3.8-flash.
GUIDE_MODEL=

# CI only: ElevenLabs model for build-time narration. Current default: eleven_multilingual_v2.
NARRATION_MODEL=

# Server only: ElevenLabs model for live guide speech. Current default: eleven_flash_v2_5.
SPEECH_MODEL=
